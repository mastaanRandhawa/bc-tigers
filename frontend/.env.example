# Frontend environment variables (Vite).
# Copy to `.env` for local overrides. All are optional — sensible defaults are
# applied in src/lib/env.ts (dev proxies /api; prod falls back to the Render URL).

# Base URL of the backend REST API, including the /api suffix.
# Dev default: "/api" (proxied to http://localhost:3000 by vite.config.ts)
# Prod default: https://bc-tigers.onrender.com/api
VITE_API_URL=

# Origin of the Socket.IO server (NOT the /api path).
# Dev default: undefined (same origin via vite proxy)
# Prod default: https://bc-tigers.onrender.com
VITE_SOCKET_URL=
