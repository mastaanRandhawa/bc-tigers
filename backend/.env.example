DATABASE_URL=postgresql://user:password@localhost:5432/bc_tigers
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# Optional — email (required for password reset delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bctigers.ca

# Dev only — expose reset token in forgot-password API response
DEV_EXPOSE_RESET_TOKEN=false

# Seed — max teams per division (default 8)
SEED_MAX_TEAMS_PER_DIVISION=8

# Seed — admin account passwords. REQUIRED in production (the seed refuses to
# run with the public demo passwords when NODE_ENV=production). Leave blank
# locally to use the demo defaults (Admin1234! / SuperAdmin1234!).
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=

# Seed — explicit opt-in for the destructive seed against a production DB.
# The seed wipes ALL tables; it refuses to run when NODE_ENV=production unless
# this is set to "true". Keep blank/false in normal operation.
ALLOW_PROD_SEED=false
