generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  TOURNAMENT_ADMIN
  COACH
  REFEREE
  PLAYER
  VIEWER
}

enum TournamentType {
  ROUND_ROBIN
  KNOCKOUT
  GROUP_STAGE_PLUS_KNOCKOUT
  LEAGUE
  HYBRID
}

enum TournamentStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  PENALTY
  ASSIST
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum BracketStage {
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
  THIRD_PLACE
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  first_name    String
  last_name     String
  email         String   @unique
  password_hash String
  phone         String?
  role          UserRole @default(VIEWER)
  profile_image String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tournament_admins TournamentAdmin[]
  notifications     Notification[]
  audit_logs        AuditLog[]
  password_reset_tokens PasswordResetToken[]
  player            Player?
  coach             Coach?
  referee           Referee?
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Tournament {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  description      String?
  start_date       DateTime
  end_date         DateTime
  location         String
  status           TournamentStatus @default(UPCOMING)
  tournament_type  TournamentType   @default(ROUND_ROBIN)
  logo             String?
  rules            String?
  created_by       String
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  divisions        Division[]
  matches          Match[]
  player_stats     PlayerStat[]
  tournament_admins TournamentAdmin[]
  media            Media[]
  notifications    Notification[]
}

model Division {
  id            String   @id @default(uuid())
  tournament_id String
  name          String
  slug          String
  age_group     String?
  gender        Gender   @default(MALE)
  max_teams     Int      @default(8)
  format        String   @default("Round Robin")
  points_win    Int      @default(3)
  points_draw   Int      @default(1)
  points_loss   Int      @default(0)
  primary_color String?
  accent_color  String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tournament    Tournament     @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  teams         Team[]
  matches       Match[]
  standings     Standing[]
  bracket_nodes BracketNode[]
  player_stats  PlayerStat[]
  stages        Stage[]
  media         Media[]

  @@unique([tournament_id, slug])
}

model Team {
  id              String   @id @default(uuid())
  division_id     String
  name            String
  slug            String
  logo            String?
  city            String?
  founded_year    Int?
  primary_color   String?
  secondary_color String?
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  division        Division      @relation(fields: [division_id], references: [id], onDelete: Cascade)
  rosters         TeamRoster[]
  team_coaches    TeamCoach[]
  home_matches    Match[]       @relation("HomeTeam")
  away_matches    Match[]       @relation("AwayTeam")
  standings       Standing[]
  match_events    MatchEvent[]
  player_stats    PlayerStat[]
  bracket_home    BracketNode[] @relation("BracketHomeTeam")
  bracket_away    BracketNode[] @relation("BracketAwayTeam")
  bracket_winner  BracketNode[] @relation("BracketWinner")

  @@unique([division_id, slug])
}

model Player {
  id                 String   @id @default(uuid())
  first_name         String
  last_name          String
  slug               String   @unique
  dob                DateTime?
  nationality        String?
  jersey_number      Int?
  preferred_position String?
  profile_image      String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user_id          String?  @unique
  rosters      TeamRoster[]
  match_events MatchEvent[]
  player_stats PlayerStat[]
  user         User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model TeamRoster {
  id         String   @id @default(uuid())
  team_id    String
  player_id  String
  season     String?
  active     Boolean  @default(true)
  joined_at  DateTime @default(now())

  team   Team   @relation(fields: [team_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([team_id, player_id, season])
}

model Coach {
  id            String @id @default(uuid())
  first_name    String
  last_name     String
  email         String? @unique
  phone         String?
  profile_image String?
  user_id       String?  @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  team_coaches TeamCoach[]
  user         User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model TeamCoach {
  id         String   @id @default(uuid())
  team_id    String
  coach_id   String
  role       String?
  joined_at  DateTime @default(now())

  team  Team  @relation(fields: [team_id], references: [id], onDelete: Cascade)
  coach Coach @relation(fields: [coach_id], references: [id], onDelete: Cascade)

  @@unique([team_id, coach_id])
}

model Venue {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  parking_info String?
  photos       String[]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  fields  Field[]
  matches Match[]
}

model Field {
  id       String  @id @default(uuid())
  venue_id String
  name     String
  surface  String?
  capacity Int?

  venue   Venue   @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  matches Match[]
}

model Referee {
  id            String   @id @default(uuid())
  first_name    String
  last_name     String
  email         String?  @unique
  phone         String?
  certification String?
  user_id       String?  @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  match_referees MatchReferee[]
  user           User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Match {
  id              String      @id @default(uuid())
  tournament_id   String
  division_id     String
  home_team_id    String
  away_team_id    String
  venue_id        String?
  field_id        String?
  stage_id        String?
  scheduled_start DateTime
  scheduled_end   DateTime?
  status          MatchStatus @default(SCHEDULED)
  round           Int?
  match_type      String?
  home_score      Int         @default(0)
  away_score      Int         @default(0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  tournament    Tournament     @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  division      Division       @relation(fields: [division_id], references: [id], onDelete: Cascade)
  home_team     Team           @relation("HomeTeam", fields: [home_team_id], references: [id])
  away_team     Team           @relation("AwayTeam", fields: [away_team_id], references: [id])
  venue         Venue?         @relation(fields: [venue_id], references: [id])
  field         Field?         @relation(fields: [field_id], references: [id])
  stage         Stage?         @relation(fields: [stage_id], references: [id])
  events        MatchEvent[]
  referees      MatchReferee[]
  bracket_nodes BracketNode[]

  @@index([status, scheduled_start])
  @@index([division_id, status])
  @@index([tournament_id, status])
}

model MatchEvent {
  id         String         @id @default(uuid())
  match_id   String
  player_id  String?
  team_id    String
  type       MatchEventType
  minute     Int
  extra_time Int?
  created_at DateTime       @default(now())

  match  Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [player_id], references: [id])
  team   Team    @relation(fields: [team_id], references: [id])
}

model MatchReferee {
  id          String @id @default(uuid())
  match_id    String
  referee_id  String
  role        String @default("MAIN")

  match   Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  referee Referee @relation(fields: [referee_id], references: [id])

  @@unique([match_id, referee_id])
}

model Stage {
  id          String @id @default(uuid())
  division_id String
  name        String
  order       Int

  division Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  matches  Match[]
}

model BracketNode {
  id           String       @id @default(uuid())
  division_id  String
  stage        BracketStage
  position     Int
  home_team_id String?
  away_team_id String?
  winner_id    String?
  match_id     String?
  created_at   DateTime     @default(now())

  division  Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  home_team Team?    @relation("BracketHomeTeam", fields: [home_team_id], references: [id])
  away_team Team?    @relation("BracketAwayTeam", fields: [away_team_id], references: [id])
  winner    Team?    @relation("BracketWinner", fields: [winner_id], references: [id])
  match     Match?   @relation(fields: [match_id], references: [id])

  @@unique([division_id, stage, position])
}

model Standing {
  id               String @id @default(uuid())
  division_id      String
  team_id          String
  played           Int    @default(0)
  wins             Int    @default(0)
  draws            Int    @default(0)
  losses           Int    @default(0)
  goals_for        Int    @default(0)
  goals_against    Int    @default(0)
  goal_difference  Int    @default(0)
  points           Int    @default(0)
  rank             Int    @default(0)
  updated_at       DateTime @updatedAt

  division Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([division_id, team_id])
  @@index([division_id, points])
}

model PlayerStat {
  id            String @id @default(uuid())
  player_id     String
  tournament_id String
  division_id   String?
  team_id       String?
  goals         Int    @default(0)
  assists       Int    @default(0)
  yellow_cards  Int    @default(0)
  red_cards     Int    @default(0)
  matches_played Int   @default(0)
  updated_at    DateTime @updatedAt

  player     Player      @relation(fields: [player_id], references: [id], onDelete: Cascade)
  tournament Tournament  @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  division   Division?   @relation(fields: [division_id], references: [id])
  team       Team?       @relation(fields: [team_id], references: [id])

  @@unique([player_id, tournament_id, division_id])
}

model TournamentAdmin {
  id            String @id @default(uuid())
  tournament_id String
  user_id       String
  role          String @default("ADMIN")
  created_at    DateTime @default(now())

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, user_id])
}

model Notification {
  id            String   @id @default(uuid())
  user_id       String?
  tournament_id String?
  title         String
  message       String
  type          String   @default("INFO")
  read          Boolean  @default(false)
  created_at    DateTime @default(now())

  user       User?       @relation(fields: [user_id], references: [id])
  tournament Tournament? @relation(fields: [tournament_id], references: [id])
}

model Media {
  id            String    @id @default(uuid())
  tournament_id String?
  division_id   String?
  match_id      String?
  type          MediaType @default(PHOTO)
  url           String
  title         String?
  description   String?
  created_at    DateTime  @default(now())

  tournament Tournament? @relation(fields: [tournament_id], references: [id])
  division   Division?   @relation(fields: [division_id], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  metadata   Json?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id                     String   @id @default("default")
  site_name              String   @default("BC Tigers Soccer")
  contact_email          String   @default("info@bctigers.ca")
  contact_phone          String?
  contact_address        String?
  timezone               String   @default("America/Vancouver")
  registration_open      Boolean  @default(true)
  notifications_enabled  Boolean  @default(true)
  live_score_updates     Boolean  @default(true)
  max_teams_per_division Int      @default(10)
  points_win             Int      @default(3)
  points_draw            Int      @default(1)
  points_loss            Int      @default(0)
  updated_at             DateTime @updatedAt
}
