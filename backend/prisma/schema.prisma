generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
}

enum TournamentType {
  ROUND_ROBIN
  KNOCKOUT
  GROUP_STAGE_PLUS_KNOCKOUT
  LEAGUE
  HYBRID
}

enum TournamentStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  COMPLETED
  DELAYED
  POSTPONED
  CANCELLED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  PENALTY
  ASSIST
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum BracketStage {
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
  THIRD_PLACE
}

enum BracketNodeStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  AUTO_ADVANCED
  INVALID
}

/// Lifecycle state for soft-deletable records. ACTIVE = live, ARCHIVED = hidden
/// but kept, DECOMMISSIONED = soft-deleted. Named `record_status` on models so it
/// never collides with domain `status` columns (e.g. Tournament.status).
enum RecordStatus {
  ACTIVE
  ARCHIVED
  DECOMMISSIONED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  first_name    String
  last_name     String
  email         String   @unique
  password_hash String
  phone         String?
  role          UserRole @default(ADMIN)
  active        Boolean  @default(true)
  profile_image String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  audit_logs            AuditLog[]
  record_versions       RecordVersion[]
  password_reset_tokens PasswordResetToken[]
}

model Tournament {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  description     String?
  start_date      DateTime
  end_date        DateTime
  location        String
  status          TournamentStatus @default(UPCOMING)
  tournament_type TournamentType   @default(ROUND_ROBIN)
  logo            String?
  rules           String?
  created_by      String
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  // ─── Soft-delete / lifecycle (shared pattern; copy to all auditable models) ───
  deleted_at    DateTime?
  deleted_by    String?
  is_deleted    Boolean      @default(false)
  record_status RecordStatus @default(ACTIVE)

  divisions     Division[]
  matches       Match[]
  announcements Announcement[]

  @@index([is_deleted])
}

model Division {
  id             String   @id @default(uuid())
  tournament_id  String
  name           String
  slug           String
  age_group      String?
  gender         Gender   @default(MALE)
  max_teams      Int      @default(8)
  format         String   @default("Round Robin")
  points_win     Int      @default(3)
  points_draw    Int      @default(1)
  points_loss    Int      @default(0)
  primary_color  String?
  accent_color   String?
  bracket_locked    Boolean  @default(false)
  bracket_finalized Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at     DateTime @updatedAt

  tournament    Tournament     @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  teams         Team[]
  matches       Match[]
  standings     Standing[]
  bracket_nodes BracketNode[]
  stages        Stage[]

  @@unique([tournament_id, slug])
}

model Team {
  id              String   @id @default(uuid())
  division_id     String
  name            String
  slug            String
  logo            String?
  city            String?
  founded_year    Int?
  primary_color   String?
  secondary_color String?
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // ─── Soft-delete / lifecycle (shared pattern; copy to all auditable models) ───
  deleted_at    DateTime?
  deleted_by    String?
  is_deleted    Boolean      @default(false)
  record_status RecordStatus @default(ACTIVE)

  division       Division      @relation(fields: [division_id], references: [id], onDelete: Cascade)
  players        Player[]
  home_matches   Match[]       @relation("HomeTeam")
  away_matches   Match[]       @relation("AwayTeam")
  standings      Standing[]
  match_events   MatchEvent[]
  bracket_home   BracketNode[] @relation("BracketHomeTeam")
  bracket_away   BracketNode[] @relation("BracketAwayTeam")
  bracket_winner BracketNode[] @relation("BracketWinner")

  @@unique([division_id, slug])
  @@index([is_deleted])
}

model Player {
  id                 String    @id @default(uuid())
  team_id            String
  first_name         String
  last_name          String
  slug               String
  dob                DateTime?
  nationality        String?
  jersey_number      Int?
  preferred_position String?
  profile_image      String?
  active             Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  team         Team         @relation(fields: [team_id], references: [id], onDelete: Cascade)
  match_events MatchEvent[]

  @@unique([team_id, slug])
  @@index([team_id, last_name])
}

model Venue {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  parking_info String?
  photos       String[]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  fields  Field[]
  matches Match[]
}

model Field {
  id       String  @id @default(uuid())
  venue_id String
  name     String
  surface  String?
  capacity Int?

  venue   Venue   @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  matches Match[]
}

model Match {
  id              String      @id @default(uuid())
  tournament_id   String
  division_id     String
  home_team_id    String
  away_team_id    String
  venue_id        String?
  field_id        String?
  stage_id        String?
  scheduled_start DateTime
  scheduled_end   DateTime?
  status          MatchStatus @default(SCHEDULED)
  round           Int?
  match_type      String?
  home_score      Int         @default(0)
  away_score      Int         @default(0)
  stream_url      String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  tournament    Tournament      @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  division      Division        @relation(fields: [division_id], references: [id], onDelete: Cascade)
  home_team     Team            @relation("HomeTeam", fields: [home_team_id], references: [id])
  away_team     Team            @relation("AwayTeam", fields: [away_team_id], references: [id])
  venue         Venue?          @relation(fields: [venue_id], references: [id])
  field         Field?          @relation(fields: [field_id], references: [id])
  stage         Stage?          @relation(fields: [stage_id], references: [id])
  events        MatchEvent[]
  officials     MatchOfficial[]
  bracket_nodes BracketNode[]

  @@index([status, scheduled_start])
  @@index([division_id, status])
  @@index([tournament_id, status])
}

model MatchEvent {
  id         String         @id @default(uuid())
  match_id   String
  player_id  String?
  team_id    String
  type       MatchEventType
  minute     Int
  extra_time Int?
  created_at DateTime       @default(now())

  match  Match   @relation(fields: [match_id], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [player_id], references: [id])
  team   Team    @relation(fields: [team_id], references: [id])
}

model MatchOfficial {
  id       String  @id @default(uuid())
  match_id String
  name     String
  role     String  @default("MAIN")
  email    String?
  phone    String?

  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@index([match_id])
}

model Stage {
  id          String @id @default(uuid())
  division_id String
  name        String
  order       Int

  division Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  matches  Match[]
}

model BracketNode {
  id                 String            @id @default(uuid())
  division_id        String
  stage              BracketStage
  position           Int
  home_team_id       String?
  away_team_id       String?
  winner_id          String?
  match_id           String?
  status             BracketNodeStatus @default(PENDING)
  next_node_id       String?
  next_slot          String?
  loser_next_node_id String?
  loser_next_slot    String?
  auto_advanced      Boolean           @default(false)
  completed_at       DateTime?
  created_at         DateTime          @default(now())

  division  Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  home_team Team?    @relation("BracketHomeTeam", fields: [home_team_id], references: [id])
  away_team Team?    @relation("BracketAwayTeam", fields: [away_team_id], references: [id])
  winner    Team?    @relation("BracketWinner", fields: [winner_id], references: [id])
  match     Match?   @relation(fields: [match_id], references: [id])

  @@unique([division_id, stage, position])
}

model Standing {
  id              String   @id @default(uuid())
  division_id     String
  team_id         String
  played          Int      @default(0)
  wins            Int      @default(0)
  draws           Int      @default(0)
  losses          Int      @default(0)
  goals_for       Int      @default(0)
  goals_against   Int      @default(0)
  goal_difference Int      @default(0)
  points          Int      @default(0)
  fair_play       Int      @default(0)
  rank            Int      @default(0)
  updated_at      DateTime @updatedAt

  division Division @relation(fields: [division_id], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([division_id, team_id])
  @@index([division_id, points])
}

model Announcement {
  id            String   @id @default(uuid())
  tournament_id String?
  title         String
  message       String
  type          String   @default("ANNOUNCEMENT")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tournament Tournament? @relation(fields: [tournament_id], references: [id], onDelete: SetNull)

  @@index([created_at])
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  metadata   Json?
  created_at DateTime @default(now())

  // ─── Enriched audit fields (centralized writer fills these from request context) ───
  previous_values Json?
  new_values      Json?
  ip_address      String?
  user_agent      String?
  request_id      String?
  source          String? // Web | Mobile | API | BackgroundJob
  notes           String?

  user User? @relation(fields: [user_id], references: [id])

  @@index([entity])
  @@index([entity_id])
  @@index([user_id])
  @@index([created_at])
  @@index([action])
}

/// Immutable, append-only per-record version history. One row per create/update/
/// delete/restore. Restoring a version writes a NEW row — history is never mutated.
model RecordVersion {
  id                  String   @id @default(uuid())
  entity_type         String
  entity_id           String
  version             Int
  previous_version_id String?
  action              String // CREATE | UPDATE | DELETE | RESTORE | RESTORE_VERSION
  changed_fields      String[]
  old_values          Json?
  new_values          Json?
  user_id             String?
  created_at          DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([entity_type, entity_id, version])
  @@index([user_id])
  @@index([created_at])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id              String   @id @default("default")
  site_name       String   @default("BC Tigers Soccer")
  contact_email   String   @default("info@bctigers.ca")
  contact_phone   String?
  contact_address String?
  timezone        String   @default("America/Vancouver")
  updated_at      DateTime @updatedAt
}
